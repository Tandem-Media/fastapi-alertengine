# ═══════════════════════════════════════════════════════════
# FastAPI AlertEngine — Zero-Config Quickstart
# ═══════════════════════════════════════════════════════════
#
# Step 1: Copy this file to .env
#         cp .env.example .env
#
# Step 2: Fill in REQUIRED fields only (5 variables)
#
# Step 3: Deploy to Railway:
#         railway up
#
# That's it. The orchestrator starts polling your FastAPI app.
# ═══════════════════════════════════════════════════════════

# ── REQUIRED (fill these in) ─────────────────────────────────

# Your FastAPI app's /health/alerts URL
# Example: https://myapp.railway.app/health/alerts
HEALTH_URL=

# Your Redis URL (Railway provides this automatically)
REDIS_URL=redis://localhost:6379/0

# Your Anthropic API key (for AI diagnosis)
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# JWT signing secret — generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
ALERT_SECRET=

# Public URL of this orchestrator (for recovery links)
# Example: https://my-alertengine.railway.app
ALERTENGINE_BASE_URL=

# ── NOTIFICATION CHANNEL (pick one) ──────────────────────────

# Option A: WhatsApp via Sent.dm (easiest — free tier available)
# Get API key at: https://sent.dm
SENT_API_KEY=
SENT_PHONE_ID=

# Option B: WhatsApp via Twilio (if you have an existing account)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Option C: Telegram (no account verification required)
# Set up a bot at: https://t.me/BotFather
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── OPTIONAL (sensible defaults already set) ──────────────────

# How often to check your app (seconds)
LOOP_INTERVAL_S=5

# Health score threshold to open an incident (0-100)
POLICY_MIN_SCORE_TO_ALERT=70

# Environment (development or production)
ENVIRONMENT=development

# ── DIFF-IN-POCKET: Git commit context (optional) ─────────────
# When set, AlertEngine correlates incidents with recent commits.
# "Database pool starving. This began 3m after commit a1b2c3d
#  changed the checkout query isolation level."
#
# Option A: Set GITHUB_TOKEN and your repo — AlertEngine polls automatically
# GITHUB_TOKEN=
# GITHUB_REPO=owner/repo
# GITHUB_BRANCH=main
#
# Option B: Push commits manually via POST /commits/{tenant_id}
# Option C: Set up a GitHub webhook to POST /commits/webhook

# ── PLAN ──────────────────────────────────────────────────────
# hobby      — $19/mo  — 1 service, 5 incidents, Telegram only
# developer  — $99/mo  — 1 service, 10 incidents, WhatsApp
# solo       — $299/mo — 3 services, 50 incidents
# startup    — $799/mo — 10 services, 200 incidents, Slack
# scale      — $1500/mo — 20 services, 1000 incidents
PLAN=developer
