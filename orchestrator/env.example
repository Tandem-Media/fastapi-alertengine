# .env.example — copy to .env and fill in your values

# AlertEngine
ALERTENGINE_REDIS_URL=redis://localhost:6379/0

# Twilio WhatsApp (get from console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+2637XXXXXXXX

# Your public URL (use ngrok for local demo)
# ngrok http 8000 → copy the https URL here
BASE_URL=https://xxxx.ngrok-free.app

# ── DIAGNOSTIC COUNCIL (optional — dual-model incident court) ─────────────────
# When enabled, two AI models with different diagnostic lenses independently
# analyze each incident. If they disagree, a "Dissent Alert" is sent instead
# of a single confident diagnosis — pre-loading the engineer with uncertainty.
#
# "The disagreement is the most important information you can give a human
#  in a high-stakes production environment."
#
# Model A — fast, latency/database specialist (default: Haiku)
# COUNCIL_MODEL_A=claude-haiku-4-5-20251001
#
# Model B — deep reasoning, network/dependency specialist (default: Sonnet)
# COUNCIL_MODEL_B=claude-sonnet-4-6
#
# Divergence threshold — below this similarity, fire dissent alert (0.0-1.0)
# COUNCIL_DIVERGENCE_THRESHOLD=0.6
#
# Disable council to reduce cost (falls back to single model)
# COUNCIL_ENABLED=true
