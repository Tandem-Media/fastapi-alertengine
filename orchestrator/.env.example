# ── Core ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0          # Redis connection URL (all files)
ALERTENGINE_BASE_URL=https://your-alertengine-service.railway.app  # base URL for recovery links (loop.py, main.py, onboard.py)
ANTHROPIC_API_KEY=sk-ant-...               # Claude API key (claude_engine.py)
ALERT_SECRET=your-shared-secret            # JWT signing secret (action_generator.py)
SERVICE_NAME=Payment API                   # default service name shown in Claude prompt (claude_engine.py, optional)

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886  # sending WhatsApp number (notifications.py, onboard.py)
TWILIO_WHATSAPP_TO=whatsapp:+1234567890    # primary WhatsApp recipient (notifications.py)
TWILIO_PHONE_NUMBER=+14155238886           # voice call from number (notifications.py)
PRIMARY_PHONE=+1234567890                  # voice call to number (notifications.py)
SECONDARY_WHATSAPP=whatsapp:+0987654321   # secondary engineer WhatsApp (notifications.py)
FALLBACK_WEBHOOK_URL=https://hooks.slack.com/...  # Slack/Teams/PagerDuty webhook (notifications.py)

# ── Loop tuning ───────────────────────────────────────────────────────────────
LOOP_INTERVAL_S=5                          # polling interval in seconds (loop.py, default: 5)
VOICE_AFTER_S=180                          # seconds before voice escalation (loop.py, policy.py, default: 180)
SECONDARY_AFTER_S=300                      # seconds before secondary escalation (loop.py, policy.py, default: 300)

# ── Policy thresholds ─────────────────────────────────────────────────────────
POLICY_MIN_SCORE_TO_ALERT=70               # minimum health score to open incident (policy.py, default: 70)
POLICY_MIN_ERR_RATE_TO_ALERT=0.1           # minimum error rate to alert (policy.py, default: 0.1)
POLICY_MIN_CONFIDENCE=0.6                  # minimum Claude confidence to act (policy.py, default: 0.6)
SUPPRESSED_ACTIONS=                        # comma-separated list of suppressed actions (policy.py)

# ── Lock ──────────────────────────────────────────────────────────────────────
LOCK_TTL_S=30                              # distributed lock TTL in seconds (lock.py, default: 30)

# ── Degraded mode ─────────────────────────────────────────────────────────────
REDIS_FAILURE_THRESHOLD=3                  # Redis failures before entering degraded mode (degraded.py, default: 3)
NOTIFY_FAILURE_THRESHOLD=5                 # notification failures before suppressing (degraded.py, default: 5)
DEGRADED_RESET_S=120                       # seconds before degraded mode resets (degraded.py, default: 120)

# ── Claude model ──────────────────────────────────────────────────────────────
CLAUDE_MODEL=claude-haiku-4-5-20251001     # Claude model to use (claude_engine.py)

# ── Recovery token ────────────────────────────────────────────────────────────
RECOVERY_TOKEN_TTL_S=300                   # recovery token TTL in seconds (action_generator.py, default: 300)

# ── Server ────────────────────────────────────────────────────────────────────
PORT=9000                                  # health/status server port (main.py, default: 9000)