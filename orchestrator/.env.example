TWILIO_WHATSAPP_TO=whatsapp:+1234567890
PRIMARY_PHONE=+1234567890
TWILIO_PHONE_NUMBER=+14155238886
SECONDARY_WHATSAPP=whatsapp:+0987654321
FALLBACK_WEBHOOK_URL=

# Telegram (alternative to WhatsApp — free, ideal for North America)
# Get bot token from @BotFather on Telegram
# Get chat_id by messaging your bot then visiting:
# https://api.telegram.org/bot{YOUR_TOKEN}/getUpdates
# These are global fallback defaults — per-tenant values are stored in Redis at onboarding
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=